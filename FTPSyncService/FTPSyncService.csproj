    <None Update="WebPages\static\profiles.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="WebPages\static\profilesHelper.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
