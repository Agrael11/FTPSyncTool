    </None>
    <None Update="WebPages\static\loginManager.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="WebPages\static\main.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
